NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Wompi (pagos en línea). Las de prueba empiezan por pub_test_ / test_.
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=pub_test_xxxxxxxx

# Server-only keys. Never expose these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
WOMPI_INTEGRITY_SECRET=test_integrity_xxxxxxxx
WOMPI_EVENTS_SECRET=test_events_xxxxxxxx
RESEND_API_KEY=re_your_key
RESEND_FROM_EMAIL=ivbags <hola@your-domain.com>
